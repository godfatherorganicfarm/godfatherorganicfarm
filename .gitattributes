# Generated by build.mjs. Committed because GitHub Pages serves them, but
# there is nothing to review here — read the diff of content/*.json instead.
# `-diff` keeps git from printing a 30,000-character line at you; GitHub
# collapses these in pull requests.
index.html          -diff linguist-generated=true
assets/*.min.css    -diff linguist-generated=true
assets/*.min.js     -diff linguist-generated=true
